  m_EditorClassIdentifier: Assembly-CSharp::MuseumImageTracker
  imageManager: {fileID: 1256382124}
  informationPanel: {fileID: 193653645}
  statusText: {fileID: 2110884641}
  titleText: {fileID: 928476076}
  detailsText: {fileID: 2068274651}
  artworks:
  - imageName: IMG_3689
    title: Saint Francis Receiving the Stigmata
    artist: El Greco
    year: "1590\u20131595"
    medium: Oil on canvas
    description: Saint Francis looks heavenwards as turbulent clouds frame his vision.
      The skull beside him is a reminder of human mortality.
  - imageName: IMG_3688
    title: The Resurrection
    artist: Antonio Palma
    year: "c. 1535\u20131580"
    medium: Oil on panel
    description: Christ rises above the crowded scene as angels and witnesses gather
      around him. The work is a large Venetian Renaissance altarpiece.
  - imageName: IMG_3719
    title: Saint Mark's Square, Venice
    artist: Canaletto
    year: c. 1756
    medium: Oil on canvas
    description: Canaletto depicts the Campanile and Procuratie Nuove in the famous
      square. Its wide-angle view may have been planned with a camera obscura.
  - imageName: IMG_3674
    title: The Gleaners
    artist: Jules Breton
    year: 1854
    medium: Oil on canvas
    description: "Women and children gather the remains of the harvest in Breton's
      native village of Courri\xE8res in northern France."
  - imageName: IMG_3715
    title: Dockers
    artist: Maurice MacGonigal
    year: 1934
    medium: Oil on canvas
    description: Three dock workers wait for work beside a red cargo ship. MacGonigal
      used models provided by trade-union leader James Larkin.
